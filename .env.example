# Beevia — local configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.
# Used by: .claude/skills/beevia-sprint-export

# ---------------------------------------------------------------------------
# 1. Zoho data centre
# ---------------------------------------------------------------------------
# The TLD of the Zoho account that owns the Sprints project. Getting this wrong
# is the most common cause of "invalid refresh token" — tokens are per-DC.
# Check the domain you see when signed in to Zoho Sprints in a browser.
#
#   com  = zoho.com   (US, default)     eu = zoho.eu   (Europe)
#   in   = zoho.in    (India)           com.au = Australia
#   jp   = zoho.jp    (Japan)           ca = zohocloud.ca (Canada)
ZOHO_DC=com

# ---------------------------------------------------------------------------
# 2. OAuth credentials
# ---------------------------------------------------------------------------
# Create a "Self Client" at https://api-console.zoho.com (choose the same DC
# as above), then:
#
#   a) Client ID + Client Secret come from the app you create there.
#   b) In the Self Client tab, generate a grant token with these scopes:
#
#        ZohoSprints.teams.READ,ZohoSprints.projects.READ,ZohoSprints.sprints.READ,ZohoSprints.items.READ
#
#      Set the duration to 10 minutes and copy the code immediately.
#   c) Exchange that one-time grant code for a refresh token (replace CODE,
#      and the .com if your DC differs):
#
#        curl -X POST "https://accounts.zoho.com/oauth/v2/token" \
#          -d "grant_type=authorization_code" \
#          -d "client_id=YOUR_CLIENT_ID" \
#          -d "client_secret=YOUR_CLIENT_SECRET" \
#          -d "code=CODE"
#
#      The response contains "refresh_token" — that is the long-lived value.
#      The access_token in the same response expires in an hour and is NOT
#      what you want here; the script mints fresh ones from the refresh token.
#
# The refresh token does not expire but IS revoked if you regenerate it or
# remove the app. Treat it like a password.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# 3. What to export
# ---------------------------------------------------------------------------
# ZOHO_TEAM_ID is your Zoho Sprints **workspace id**. The API still calls it
# "team"; the UI calls it a workspace. It is the long number in the browser URL
# while you are looking at the board.
#
# ZOHO_PROJECT_ID: leave blank on first run, then use
#
#   python3 .claude/skills/beevia-sprint-export/scripts/zoho_export.py --probe
#
# which lists the projects and sprints visible to your token, with their ids.
# Both values below are VERIFIED against the live API for this account:
#   team    910540998          (workspace "blomgram")
#   project 187554000000089145 (project "Beevia")
ZOHO_TEAM_ID=910540998
ZOHO_PROJECT_ID=187554000000089145

# Sprint name filter, matched as a case-insensitive substring. This reproduces
# the "Sprints Contains 0702" filter shown in your manual exports. Leave blank
# to export every sprint.
ZOHO_SPRINT_FILTER=0702

# ---------------------------------------------------------------------------
# 4. CSV preamble
# ---------------------------------------------------------------------------
# Written into the first five lines of the export, matching Zoho's UI output
# so an automated export diffs cleanly against a manual one.
EXPORT_TEAM_NAME=blomgram
EXPORT_PROJECT_NAME=Beevia
EXPORT_EXPORTED_BY=Victor Peynado

# ---------------------------------------------------------------------------
# 5. Optional overrides
# ---------------------------------------------------------------------------
# Only set this if Zoho moves the Sprints API off the documented host. The
# default is https://sprintsapi.zoho.<ZOHO_DC>/zsapi
# ZOHO_API_BASE=
